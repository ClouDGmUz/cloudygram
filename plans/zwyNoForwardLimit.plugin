def split_list_into_chunks(lst: List[int], chunk_size: int) -> List[List[int]]:
    return [lst[i:i + chunk_size] for i in range(0, len(lst), chunk_size)]


def delete_messages_hook(param):
    first_msg_array = param.args[0]
    second_msg_array = param.args[1]

    if first_msg_array.size() > 0:
        msgs = first_msg_array
        selected_msg_array_arg_index = 0
    else:
        msgs = second_msg_array
        selected_msg_array_arg_index = 1

    messages = zwylib.arraylist_to_list(msgs)
    if len(messages) <= CHUNK_SIZE:
        return

    message_ids_chunks: List[List[int]] = split_list_into_chunks(messages, CHUNK_SIZE)
    last_chunk_index = len(message_ids_chunks) - 1

    for index, chunk in enumerate(message_ids_chunks):
        param.args[selected_msg_array_arg_index] = zwylib.iterable_to_arraylist(chunk)
        if index < last_chunk_index:
            param.method.invoke(param.thisObject, param.args)


@dataclass
class ForwardCache:
    selected_account: Optional[int] = None
    thread_message: Optional[MessageObject] = None
    send_mono_forum_peer_id: Optional[int] = None
    send_message_suggestion_params: Optional[Any] = None
    send_messages_helper: Optional[Any] = None

    def clear(self):
        self.selected_account = None
        self.thread_message = None
        self.send_mono_forum_peer_id = None
        self.send_message_suggestion_params = None
        self.send_messages_helper = None


async def show_chat_forward_popup(ctx):
    chat_id: int = -ctx.get("dialog_id")
    topic_id: int = get_last_fragment().getTopicId()

    try:
        response = await Requests.search_messages(-chat_id, limit=1, top_msg_id=topic_id)
    except Exception:
        show_general_error(exc=True)
        return

    messages_count = response.count
    if topic_id != 0:
        messages_count -= 1  # do not count topic creation message

    def proceed(noquote: bool):
        run_async(start_chat_forward(ctx, response.count, noquote))

    run_on_ui_thread(UI.AlertDialog(
        title=L.forward_all_popup_title,
        text=L.forward_all_popup_text(count=messages_count),
        buttons=[
            UI.AlertButton(L.confirm, lambda _, __: proceed(noquote=False)),
            UI.AlertButton(L.noquote, lambda _, __: proceed(noquote=True), type=AlertDialogBuilder.BUTTON_NEUTRAL),
            UI.AlertButton(L.close, type=AlertDialogBuilder.BUTTON_NEGATIVE),
        ]
    ).show)


async def start_chat_forward(ctx, total_msg_count: int, noquote: bool):
    chat_activity = get_last_fragment()
    loop = zwylib.async_manager.loop

    try:
        picked = await DialogPicker.pick_chat()
    except Exception as e:
        if not "cancelled" in str(e).lower():
            show_general_error(exc=True)
        return

    def forward_messages(future: asyncio.Future, messages: ArrayList, cache: ForwardCache):
        cache.send_messages_helper.sendMessage(
            zwylib.iterable_to_arraylist(messages),  # arrayList
            -picked.dialog_id,  # dialog_id (peer_id)
            noquote,  # fromMyName (hideSenderName)
            False,  # hideCaption
            True,  # notify
            0,  # scheduleDate
            0,
            cache.thread_message,
            -1,
            0,  # payStars
            cache.send_mono_forum_peer_id,
            cache.send_message_suggestion_params
        )

        if not future.done():
            loop.call_soon_threadsafe(future.set_result, None)

    async def worker(sheet: UI.BottomSheet):
        chat_id: int = -ctx.get("dialog_id")
        top_msg_id = chat_activity.getTopicId()
        cache = ForwardCache(
            selected_account=get_user_config().selectedAccount,
            thread_message=chat_activity.getThreadMessage(),
            send_mono_forum_peer_id=chat_activity.getSendMonoForumPeerId(),
            send_message_suggestion_params=chat_activity.getSendMessageSuggestionParams(),
            send_messages_helper=get_send_messages_helper(),
        )

        offset_id = 0
        forwarded_count = 0
        current_count = 100

        try:
            while current_count == 100 and not sheet.dissmissed:
                response = await Requests.search_messages(-chat_id, limit=100, offset_id=offset_id, top_msg_id=top_msg_id)
                messages = getattr(response, "messages", None)

                if not messages or messages.isEmpty():
                    break

                message_ids = []
                message_objects = []

                for msg in zwylib.arraylist_to_list(messages):
                    message_ids.append(msg.id)

                    msg_obj = MessageObject(cache.selected_account, msg, False, False)
                    if msg_obj.canForwardMessage() and not isinstance(msg, TLRPC.TL_messageService):
                        message_objects.append(msg_obj)

                current_count = len(message_ids)
                min_id = min(message_ids)
                offset_id = min_id

                future = loop.create_future()
                run_on_ui_thread(lambda: forward_messages(future, message_objects, cache))
                await future

                forwarded_count += current_count
                progress = forwarded_count / total_msg_count
                sheet.update_status(progress, L.forward_all_sheet_desc(current=forwarded_count, total=total_msg_count))

                sleep_time = random.uniform(2, 5) if not forwarded_count == total_msg_count else 1
                await asyncio.sleep(sleep_time)

            run_on_ui_thread(
                lambda: bulletin.show_success(L.forward_all_success_bulletin(count=forwarded_count)),
                delay=50
            )
        except Exception:
            logger.error("An error occurred:", exc_info=True)
            show_general_error(exc=True)
        finally:
            sheet.finish()
            cache.clear()

    def show_sheet():
        sheet = UI.BottomSheet(L.forward_all_sheet_title, "..", random.choice(stickers), worker)
        sheet.show()
        sheet.start_worker()

    run_on_ui_thread(show_sheet)


def show_general_error(text_to_log: Optional[str] = None, exc=False):
    object_to_log = text_to_log if not exc else zwylib.format_exc()
    logger.error("An error occurred:", object_to_log)
    bulletin.show_error_with_copy(L.general_error, object_to_log)


class DexLoader:
    def __init__(self):
        self.java_class = None

    def inject(self) -> bool:
        if Build.VERSION.SDK_INT < Build.VERSION_CODES.O:
            logger.error("InMemoryDexClassLoader requires Android 8.0 or greater.")
            bulletin.show_error(L.dex_not_supported)
            return False

        ctx = ApplicationLoader.applicationContext
        compressed_dex_bytes = base64.b64decode(DEX_BASE64.strip())

        try:
            dex_bytes = lzma.decompress(compressed_dex_bytes)
        except Exception:
            logger.error("Failed to decompress DEX with LZMA:", exc_info=True)
            return False

        try:
            buffer = ByteBuffer.wrap(dex_bytes)
            class_loader = InMemoryDexClassLoader(buffer, ctx.getClassLoader())

            self.java_class = class_loader.loadClass("org.zwylair.nfldex.PluginCore")
            self.java_class.getDeclaredMethod(
                "init",
                jclass("android.content.Context"),
                jclass("java.lang.String"),
            ).invoke(None, ctx, __id__)

            logger.info("DEX loaded successfully.")
            return True
        except Exception:
            logger.warning("InMemoryDexClassLoader load failed:", exc_info=True)
            return False


