logger = zwylib.build_log(__name__)
bulletin = zwylib.build_bulletin_helper()
run_async = zwylib.async_manager.run_task
dex_loader = DexLoader()


class NoForwardLimit(BasePlugin):
    def on_plugin_load(self):
        zwylib.add_autoupdater_task(AUTOUPDATE_CHANNEL_ID, AUTOUPDATE_MSG_ID)

        self.add_on_send_message_hook()
        self.add_hook("TL_messages_forwardMessages")

        method = HookUtils.find_max_args_method(get_messages_controller().getClass(), "deleteMessages")
        HookUtils.hook_before(method, delete_messages_hook)

        self.add_menu_item(MenuItemData(
            menu_type=MenuItemType.CHAT_ACTION_MENU,
            text=L.forward_all_menu,
            icon="msg_forward",
            on_click=lambda ctx: run_async(show_chat_forward_popup(ctx))
        ))

        if not dex_loader.inject():
            raise Exception("Failed to load dex module.")

        logger.info("Loaded.")

    def on_plugin_unload(self):
        if dex_loader.java_class:
            try:
                dex_loader.java_class.getDeclaredMethod("unload").invoke(None)
            except Exception:
                logger.error("Dex unload error:", exc_info=True)
            finally:
                dex_loader.java_class = None
        logger.info("Unloaded.")

    def pre_request_hook(self, req_name, account, req):
        if req_name == "TL_messages_forwardMessages" and dex_loader.java_class:
            try:
                dex_loader.java_class.getDeclaredMethod("clearSelectorStorage").invoke(None)
            except Exception:
                logger.error("Failed to clear storage:", exc_info=True)
