__id__ = "compact_bottom_nav"
__name__ = "CompactBottomNav"
__description__ = "Компактная нижняя панель без подписей с поддержкой Glass и Material 3."
__author__ = "@RnPlugins"
__version__ = "1.0.2"
__build__ = 2
__icon__ = "RnDev/18"
__app_version__ = ">=12.10.1"
__sdk_version__ = ">=1.4.3.3"

import base64
import traceback
from base_plugin import BasePlugin
from java.nio import ByteBuffer
from dalvik.system import InMemoryDexClassLoader
from org.telegram.messenger import ApplicationLoader
from android_utils import run_on_ui_thread
from ui.settings import Header, Switch, Text

DEX_B64 = """"""

class CompactBottomNavPlugin(BasePlugin):
    def on_plugin_load(self):
        self.dex_class = None
        self.dex_loader = None
        self.author_sheet_class = None
        try:
            dex_bytes = base64.b64decode(DEX_B64)
            buffer = ByteBuffer.wrap(dex_bytes)
            parent_cl = ApplicationLoader.applicationContext.getClassLoader()
            self.dex_loader = InMemoryDexClassLoader(buffer, parent_cl)
            self.dex_class = self.dex_loader.loadClass("dev.rooni.compactbottomnav.CompactBottomNav")
            self.author_sheet_class = self.dex_loader.loadClass("dev.rooni.author.AuthorBottomSheet")
            
            start_method = self.dex_class.getMethod("start")
            start_method.invoke(None)
            
            self.apply_settings()
            run_on_ui_thread(self.check_author_promo, delay=700)
        except Exception as e:
            self.log(f"Failed to load Java CompactBottomNav module: {e}\n{traceback.format_exc()}")

    def check_author_promo(self):
        try:
            if self.get_setting("author_promo_shown", False):
                return

            if getattr(self, "author_sheet_class", None) is None:
                return

            is_sub = self.author_sheet_class.getMethod("isSubscribedToAuthor").invoke(None)
            if is_sub:
                self.set_setting("author_promo_shown", True)
                return

            shown = self.author_sheet_class.getMethod("showFromCurrentActivity").invoke(None)
            if shown:
                self.set_setting("author_promo_shown", True)
        except Exception as e:
            self.log(f"[CompactBottomNav] Error in check_author_promo: {e}\n{traceback.format_exc()}")

    def show_author_sheet(self):
        try:
            if getattr(self, "author_sheet_class", None) is not None:
                self.author_sheet_class.getMethod("showFromCurrentActivity").invoke(None)
        except Exception as e:
            self.log(f"[CompactBottomNav] Error showing author sheet: {e}\n{traceback.format_exc()}")

    def on_author_click(self, _=None):
        self.show_author_sheet()

    def on_plugin_unload(self):
        try:
            if hasattr(self, "dex_class") and self.dex_class is not None:
                stop_method = self.dex_class.getMethod("stop")
                stop_method.invoke(None)
            self.dex_class = None
            self.author_sheet_class = None
            self.dex_loader = None
        except Exception as e:
            self.log(f"Failed to unload Java CompactBottomNav module: {e}")

    def apply_settings(self):
        try:
            hide_labels = bool(self.get_setting("hide_labels", True))
            add_search_button = bool(self.get_setting("add_search_button", True))
            hide_actionbar_search = bool(self.get_setting("hide_actionbar_search", False))
            
            if self.dex_class is not None:
                for method in self.dex_class.getMethods():
                    if method.getName() == "updateSettings" and len(method.getParameterTypes()) == 3:
                        method.invoke(None, hide_labels, add_search_button, hide_actionbar_search)
                        break
        except Exception as e:
            self.log(f"[CompactBottomNav] Apply settings error: {e}\n{traceback.format_exc()}")

    def create_settings(self):
        return [
            Header(text="Нижняя панель"),
            Switch(
                key="hide_labels",
                text="Скрыть подписи",
                subtext="Убрать названия разделов",
                default=True,
                icon="msg_edit",
                on_change=lambda val: self.apply_settings()
            ),
            Switch(
                key="add_search_button",
                text="Кнопка поиска",
                subtext="Плавающая кнопка поиска рядом с панелью (в стиле Glass)",
                default=True,
                icon="msg_search",
                on_change=lambda val: self.apply_settings()
            ),
            Header(text="Верхняя панель (ActionBar)"),
            Switch(
                key="hide_actionbar_search",
                text="Скрыть поиск в шапке",
                subtext="Скрыть кнопку поиска из верхней панели",
                default=False,
                icon="msg_search",
                on_change=lambda val: self.apply_settings()
            ),
            Header(text="Об авторе"),
            Text(
                text="Автор",
                subtext="Информация о разработчике",
                icon="msg_openprofile",
                on_click=self.on_author_click
            )
        ]
